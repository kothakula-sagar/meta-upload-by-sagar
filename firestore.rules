rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /entities/{id} {
      allow read, write: if signedIn();
    }

    match /services/{id} {
      allow read, write: if signedIn();
    }

    match /posts/{id} {
      allow read, write: if signedIn();
    }

    match /settings/{id} {
      allow read, write: if signedIn();
    }

    match /telegram/{id} {
      allow read, write: if signedIn();
    }

    match /logs/{id} {
      allow read, write: if signedIn();
    }
  }
}